---
import openToWorkImg from "../assets/open_to_work.png";
---

<div
  class="flex items-center gap-2 self-start rounded-full bg-[rgba(64,244,194,0.12)] px-[14px] py-[6px] text-[12px] font-medium uppercase tracking-[0.04em] text-[#f4d940] m-auto"
>
  <img
    class="mr-1 inline-block h-[16px] w-[16px] animate-[blink_2.2s_linear_infinite]"
    src={openToWorkImg.src}
    alt=""
    loading="lazy"
  />
  OPEN TO WORK
</div>

<style>
  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>
