---
import HomeSection from "./HomeSection.astro";
import AboutSection from "./AboutSection.astro";
import SkillsSection from "./SkillsSection.astro";
import WorksSection from "./WorksSection.astro";
import ContactSection from "./ContactSection.astro";
---

<div class="page">
  <main>
    <HomeSection />
    <AboutSection />
    <SkillsSection />
    <WorksSection />
    <ContactSection />
  </main>
</div>

<style>
  .page {
    min-height: 100vh;
    background: radial-gradient(circle at 20% 20%, rgba(33, 211, 194, 0.08), transparent 55%),
      radial-gradient(circle at 80% 30%, rgba(33, 211, 194, 0.08), transparent 60%),
      linear-gradient(180deg, rgba(13, 21, 32, 0.95), rgba(13, 21, 32, 1));
    position: relative;
  }

  .page::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image: url('data:image/svg+xml,%3Csvg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg"%3E%3Cpath d="M20 60Q60 20 120 40T240 40T360 20" fill="none" stroke="%2324343f" stroke-width="1" opacity="0.5"/%3E%3Cpath d="M20 140Q80 100 140 120T260 120T360 100" fill="none" stroke="%2324343f" stroke-width="1" opacity="0.4"/%3E%3Cpath d="M20 220Q60 260 140 240T260 240T360 220" fill="none" stroke="%2324343f" stroke-width="1" opacity="0.35"/%3E%3Cpath d="M20 300Q80 340 140 320T260 320T360 300" fill="none" stroke="%2324343f" stroke-width="1" opacity="0.3"/%3E%3C/svg%3E');
    background-size: 500px;
    opacity: 0.35;
    z-index: 0;
  }

  .page > * {
    position: relative;
    z-index: 1;
  }
</style>

<style is:global>
  .section {
    padding: 64px 0;
  }

  .lead {
    color: #cbd5f5;
    margin: 0;
    line-height: 1.6;
  }

  .text-link {
    color: #f4d940;
    font-weight: 500;
    font-size: 14px;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .text-link::after {
    content: "";
    width: 14px;
    height: 14px;
    border-top: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    transform: rotate(45deg);
    margin-top: 2px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 999px;
    font-weight: 500;
    font-size: 13px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .button.primary {
    background: #f4d940;
    color: #05292a;
  }

  .button.primary:hover {
    box-shadow: 0 8px 20px rgb(19, 45, 47, 0.3);
  }

  .button.ghost {
    border-color: rgba(148, 163, 184, 0.3);
    color: #cbd5f5;
    fill: #cbd5f5;
    background: transparent;
  }

  .button.ghost:hover {
    border-color: rgb(19, 45, 47, 0.5);
    color: #f4d940;
    fill: #f4d940;
  }

  .section-title h2,
  .section-header h2 {
    font-size: 28px;
    margin: 0;
  }

  .title-accent {
    width: 80px;
    height: 4px;
    background: linear-gradient(90deg, #f4d940, rgb(19, 45, 47, 0));
    border-radius: 999px;
    margin-top: 12px;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 32px;
  }

  .section-header p {
    margin: 0;
    color: #94a3b8;
  }

  @media (max-width: 768px) {
    .section {
      padding: 56px 0;
    }
  }

  @media (max-width: 540px) {
    .section-title h2,
    .section-header h2 {
      font-size: 24px;
    }
  }
</style>
