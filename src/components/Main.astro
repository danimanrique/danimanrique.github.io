---
import HomeSection from "./HomeSection.astro";
import AboutSection from "./AboutSection.astro";
import ServicesSection from "./ServicesSection.astro";
import SkillsSection from "./SkillsSection.astro";
import WorksSection from "./WorksSection.astro";
import ContactSection from "./ContactSection.astro";
---

<div
  class="page relative min-h-screen bg-[radial-gradient(circle_at_20%_20%,rgba(33,211,194,0.08),transparent_55%),radial-gradient(circle_at_80%_30%,rgba(33,211,194,0.08),transparent_60%),linear-gradient(180deg,rgba(13,21,32,0.95),rgba(13,21,32,1))]"
>
  <main>
    <HomeSection />
    <AboutSection />
    <ServicesSection />
    <SkillsSection />
    <WorksSection />
    <ContactSection />
  </main>
</div>

<style>
  .page::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image: url('data:image/svg+xml,%3Csvg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg"%3E%3Cpath d="M20 60Q60 20 120 40T240 40T360 20" fill="none" stroke="%2324343f" stroke-width="1" opacity="0.5"/%3E%3Cpath d="M20 140Q80 100 140 120T260 120T360 100" fill="none" stroke="%2324343f" stroke-width="1" opacity="0.4"/%3E%3Cpath d="M20 220Q60 260 140 240T260 240T360 220" fill="none" stroke="%2324343f" stroke-width="1" opacity="0.35"/%3E%3Cpath d="M20 300Q80 340 140 320T260 320T360 300" fill="none" stroke="%2324343f" stroke-width="1" opacity="0.3"/%3E%3C/svg%3E');
    background-size: 500px;
    opacity: 0.35;
    z-index: 0;
  }

  .page > * {
    position: relative;
    z-index: 1;
  }
</style>
