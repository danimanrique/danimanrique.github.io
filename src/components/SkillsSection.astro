<section id="skills" class="py-20">
  <div class="mx-auto max-w-[1100px] px-6 max-[540px]:px-[18px]">
    <div class="mb-8 flex flex-col gap-3 text-center lg:text-left">
      <h2 class="m-0 text-2xl font-semibold text-slate-50 lg:text-[28px]">Skills</h2>
      <p class="m-0 text-sm text-slate-400">
        Construyo experiencias completas desde el diseño hasta el deploy en producción.
      </p>
    </div>
    <div class="mb-8 grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-5">
      <article class="rounded-[20px] border border-[rgba(19,45,47,0.2)] bg-[rgba(15,24,38,0.9)] p-6">
        <h3 class="mb-2 mt-0 text-lg font-semibold text-slate-100">Front End Development</h3>
        <p class="m-0 text-xs font-medium uppercase tracking-[0.08em] text-[#f4d940]">HTML · CSS · Angular · React</p>
      </article>
      <article class="rounded-[20px] border border-[rgba(19,45,47,0.2)] bg-[rgba(15,24,38,0.9)] p-6">
        <h3 class="mb-2 mt-0 text-lg font-semibold text-slate-100">Back End Development</h3>
        <p class="m-0 text-xs font-medium uppercase tracking-[0.08em] text-[#f4d940]">Node.js · Express · NestJS · MySQL</p>
      </article>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-5">
      <article class="rounded-[20px] border border-[rgba(19,45,47,0.2)] bg-[rgba(15,24,38,0.9)] p-6">
        <h3 class="mb-2 mt-0 text-lg font-semibold text-slate-100">App Development</h3>
        <p class="m-0 text-xs font-medium uppercase tracking-[0.08em] text-[#f4d940]">
          Ionic · Capacitor · React Native · Expo
        </p>
      </article>
      <article class="rounded-[20px] border border-[rgba(19,45,47,0.2)] bg-[rgba(15,24,38,0.9)] p-6">
        <h3 class="mb-2 mt-0 text-lg font-semibold text-slate-100">DevOps</h3>
        <p class="m-0 text-xs font-medium uppercase tracking-[0.08em] text-[#f4d940]">Docker · CI/CD</p>
      </article>
      <article class="rounded-[20px] border border-[rgba(19,45,47,0.2)] bg-[rgba(15,24,38,0.9)] p-6">
        <h3 class="mb-2 mt-0 text-lg font-semibold text-slate-100">Automaticación</h3>
        <p class="m-0 text-xs font-medium uppercase tracking-[0.08em] text-[#f4d940]">N8N · Make</p>
      </article>
    </div>
  </div>
</section>
