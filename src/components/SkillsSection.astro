<section id="skills" class="section">
  <div class="container">
    <div class="section-header">
      <h2>Skills</h2>
      <p>Construyo experiencias completas desde el diseño hasta el deploy en producción.</p>
    </div>
    <div class="services">
      <article class="service">
        <h3>Front End Development</h3>
        <p>HTML · CSS · Angular · React</p>
      </article>
      <article class="service">
        <h3>Back End Development</h3>
        <p>Node.js · Express · NestJS · MySQL</p>
      </article>
    </div>
    <div class="services">
      <article class="service">
        <h3>App Development</h3>
        <p>Ionic · Capacitor · React Native · Expo</p>
      </article>
      <article class="service">
        <h3>DevOps</h3>
        <p>Docker · CI/CD</p>
      </article>
      <article class="service">
        <h3>Automaticación</h3>
        <p>N8N · Make</p>
      </article>
    </div>
  </div>
</section>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  .service {
    padding: 24px;
    border-radius: 20px;
    background: rgba(15, 24, 38, 0.9);
    border: 1px solid rgb(19, 45, 47, 0.2);
  }

  .service h3 {
    margin: 0 0 8px;
    font-size: 18px;
    color: #e2e8f0;
  }

  .service p {
    margin: 0;
    color: #f4d940;
    font-size: 13px;
  }

  .skill-tags {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 540px) {
    .services {
      grid-template-columns: 1fr;
    }

    .skill-tags {
      justify-content: center;
    }
  }
</style>
