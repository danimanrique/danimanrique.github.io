---
import p1Img from "../assets/proyectos/p1.png";
import p2Img from "../assets/proyectos/p2.png";
import p3Img from "../assets/proyectos/p3.png";
import p4Img from "../assets/proyectos/p4.png";
import p5Img from "../assets/proyectos/p5.png";
---

<section id="works" class="py-20">
  <div class="mx-auto max-w-[1100px] px-6 max-[540px]:px-[18px]">
    <div class="mb-10 flex flex-col gap-3 text-center lg:text-left">
      <h2 class="m-0 text-2xl font-semibold text-slate-50 lg:text-[28px]">Proyectos</h2>
      <p class="m-0 text-sm text-slate-400">
        Una selección de trabajos recientes y proyectos en los que he participado.
      </p>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(360px,1fr))] gap-6">
      <article
        class="grid overflow-hidden rounded-[24px] border border-[rgba(148,163,184,0.2)] bg-[rgba(15,24,38,0.85)]"
      >
        <div
          class="relative after:absolute after:inset-0 after:bg-[linear-gradient(180deg,transparent,rgba(15,24,38,0.6))]"
        >
          <img src={p4Img.src} alt="Project preview" loading="lazy" />
        </div>
        <div class="flex flex-col gap-3 p-6">
          <h3 class="m-0 text-xl font-semibold text-slate-100">Sistema de Monitoreo IoT</h3>
          <p class="m-0 leading-relaxed text-slate-400">
            Permite la administración y monitoreo de dispositivos IoT (específicamente dispositivos Ewon)
          </p>
          <p class="m-0 italic text-slate-400">Proyecto Privado</p>
        </div>
      </article>
      <article
        class="grid overflow-hidden rounded-[24px] border border-[rgba(148,163,184,0.2)] bg-[rgba(15,24,38,0.85)]"
      >
        <div
          class="relative after:absolute after:inset-0 after:bg-[linear-gradient(180deg,transparent,rgba(15,24,38,0.6))]"
        >
          <img src={p2Img.src} alt="Project preview" loading="lazy" />
        </div>
        <div class="flex flex-col gap-3 p-6">
          <h3 class="m-0 text-xl font-semibold text-slate-100">Landing Page</h3>
          <p class="m-0 leading-relaxed text-slate-400">
            Página web personal diseñada para Alicia Susana Arias, escritora de literatura contemporánea.
          </p>
          <a
            class="group inline-flex items-center gap-2 text-sm font-medium text-[#f4d940] transition-transform hover:translate-x-[2px]"
            href="https://alicia-arias.com/"
            target="_blank"
          >
            Ver sitio
            <span
              class="block h-[14px] w-[14px] rotate-45 border-r border-t border-current transition-transform group-hover:translate-x-[2px]"
            ></span>
          </a>
        </div>
      </article>
      <article
        class="grid overflow-hidden rounded-[24px] border border-[rgba(148,163,184,0.2)] bg-[rgba(15,24,38,0.85)]"
      >
        <div
          class="relative after:absolute after:inset-0 after:bg-[linear-gradient(180deg,transparent,rgba(15,24,38,0.6))]"
        >
          <img src={p1Img.src} alt="Project preview" loading="lazy" />
        </div>
        <div class="flex flex-col gap-3 p-6">
          <h3 class="m-0 text-xl font-semibold text-slate-100">Sistema de Gestión Interno</h3>
          <p class="m-0 leading-relaxed text-slate-400">
            Aplicación web para la gestión de procesos de obras públicas.
          </p>
          <p class="m-0 italic text-slate-400">Proyecto Privado</p>
        </div>
      </article>
      <article
        class="grid overflow-hidden rounded-[24px] border border-[rgba(148,163,184,0.2)] bg-[rgba(15,24,38,0.85)]"
      >
        <div
          class="relative after:absolute after:inset-0 after:bg-[linear-gradient(180deg,transparent,rgba(15,24,38,0.6))]"
        >
          <img src={p5Img.src} alt="Project preview" loading="lazy" />
        </div>
        <div class="flex flex-col gap-3 p-6">
          <h3 class="m-0 text-xl font-semibold text-slate-100">Pila: app financiera</h3>
          <p class="m-0 leading-relaxed text-slate-400">
            Landing creada con Astro para presentar Pila: una app de finanzas personales 
          </p>
          <a
            class="group inline-flex items-center gap-2 text-sm font-medium text-[#f4d940] transition-transform hover:translate-x-[2px]"
            href="https://pila.ar/"
            target="_blank"
          >
            Ver sitio
            <span
              class="block h-[14px] w-[14px] rotate-45 border-r border-t border-current transition-transform group-hover:translate-x-[2px]"
            ></span>
          </a>
        </div>
      </article>
      <article
        class="grid overflow-hidden rounded-[24px] border border-[rgba(148,163,184,0.2)] bg-[rgba(15,24,38,0.85)]"
      >
        <div
          class="relative after:absolute after:inset-0 after:bg-[linear-gradient(180deg,transparent,rgba(15,24,38,0.6))]"
        >
          <img src={p3Img.src} alt="Project preview" loading="lazy" />
        </div>
        <div class="flex flex-col gap-3 p-6">
          <h3 class="m-0 text-xl font-semibold text-slate-100">Pomodoro Timer</h3>
          <p class="m-0 leading-relaxed text-slate-400">
            Temporizador construido con Angular, diseñado para ayudarte a mantener el enfoque y mejorar tu
            productividad.
          </p>
          <a
            class="group inline-flex items-center gap-2 text-sm font-medium text-[#f4d940] transition-transform hover:translate-x-[2px]"
            href="https://kaleidoscopic-youtiao-799be5.netlify.app/"
            target="_blank"
          >
            Ver sitio
            <span
              class="block h-[14px] w-[14px] rotate-45 border-r border-t border-current transition-transform group-hover:translate-x-[2px]"
            ></span>
          </a>
        </div>
      </article>
      
    </div>
  </div>
</section>
