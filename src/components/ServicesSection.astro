---

---

<section id="services" class="py-20">
  <div class="mx-auto max-w-[1100px] px-6 max-[540px]:px-[18px]">
    <div class="mb-10 flex flex-col gap-3 text-center lg:text-left">
      <h2 class="m-0 text-2xl font-semibold text-slate-50 lg:text-[28px]">Servicios</h2>
      <p class="m-0 text-sm text-slate-400">
        Te acompaño en todo el ciclo: desde la idea hasta el lanzamiento y el soporte continuo.
      </p>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-6">
      <article
        class="group relative overflow-hidden rounded-[22px] border border-[rgba(148,163,184,0.18)] bg-[rgba(15,24,38,0.9)] p-7"
      >
        <div
          class="absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-[#f4d940] via-[#9de1d4] to-transparent opacity-70"
        >
        </div>
        <div class="mb-4 flex items-center gap-3">
          <div
            class="grid h-10 w-10 place-items-center rounded-[12px] border border-[rgba(244,217,64,0.45)] bg-[rgba(244,217,64,0.1)] text-sm font-semibold text-[#f4d940]"
          >
            01
          </div>
          <h3 class="m-0 text-lg font-semibold text-slate-100">Desarrollo web a medida</h3>
        </div>
        <p class="m-0 text-sm text-slate-300">
          Sitios y apps web optimizados, accesibles y listos para crecer, con foco en la experiencia de usuario.
        </p>
        <ul class="m-0 mt-4 flex flex-wrap gap-2 p-0 text-[12px] text-slate-200">
          <li class="rounded-full bg-[rgba(244,217,64,0.08)] px-3 py-1 text-[#f4d940]">Landing · Ecommerce</li>
          <li class="rounded-full bg-[rgba(19,45,47,0.35)] px-3 py-1">SPA · SSR</li>
        </ul>
      </article>

      <article
        class="group relative overflow-hidden rounded-[22px] border border-[rgba(148,163,184,0.18)] bg-[rgba(15,24,38,0.9)] p-7"
      >
        <div
          class="absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-[#9de1d4] via-[#f4d940] to-transparent opacity-70"
        >
        </div>
        <div class="mb-4 flex items-center gap-3">
          <div
            class="grid h-10 w-10 place-items-center rounded-[12px] border border-[rgba(157,225,212,0.45)] bg-[rgba(157,225,212,0.08)] text-sm font-semibold text-[#9de1d4]"
          >
            02
          </div>
          <h3 class="m-0 text-lg font-semibold text-slate-100">Arquitectura y APIs</h3>
        </div>
        <p class="m-0 text-sm text-slate-300">
          Diseño y desarrollo de APIs seguras, escalables y bien documentadas, listas para integrarse con tus productos.
        </p>
        <ul class="m-0 mt-4 flex flex-wrap gap-2 p-0 text-[12px] text-slate-200">
          <li class="rounded-full bg-[rgba(157,225,212,0.1)] px-3 py-1 text-[#9de1d4]">REST · GraphQL</li>
          <li class="rounded-full bg-[rgba(19,45,47,0.35)] px-3 py-1">Tests · Monitoreo</li>
        </ul>
      </article>

      <article
        class="group relative overflow-hidden rounded-[22px] border border-[rgba(148,163,184,0.18)] bg-[rgba(15,24,38,0.9)] p-7"
      >
        <div
          class="absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-[#f4d940] via-[#9de1d4] to-transparent opacity-70"
        >
        </div>
        <div class="mb-4 flex items-center gap-3">
          <div
            class="grid h-10 w-10 place-items-center rounded-[12px] border border-[rgba(244,217,64,0.45)] bg-[rgba(244,217,64,0.1)] text-sm font-semibold text-[#f4d940]"
          >
            03
          </div>
          <h3 class="m-0 text-lg font-semibold text-slate-100">Automatización y optimización</h3>
        </div>
        <p class="m-0 text-sm text-slate-300">
          Integraciones, flujos automatizados y observabilidad para reducir tareas manuales y mejorar la operación.
        </p>
        <ul class="m-0 mt-4 flex flex-wrap gap-2 p-0 text-[12px] text-slate-200">
          <li class="rounded-full bg-[rgba(244,217,64,0.08)] px-3 py-1 text-[#f4d940]">N8N · Make</li>
          <li class="rounded-full bg-[rgba(19,45,47,0.35)] px-3 py-1">Alertas · Dashboards</li>
        </ul>
      </article>
    </div>
  </div>
</section>
